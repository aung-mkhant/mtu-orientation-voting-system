<h1>Admin Dashboard</h1>

<table class="table auto">
  <thead>
    <tr>
      <th>King Vote</th>
      <th>Queen Vote</th>
      <th>Smart Vote</th>
      <th>Style Vote</th>
      <th>Popular Vote</th>
      <th>Created At</th>
    </tr>
  </thead>
  <tbody>
    <% votes.forEach((vote) => { %>
    <tr>
      <td><%= vote.kingNominee.name %></td>
      <td><%= vote.queenNominee.name %></td>
      <td><%= vote.smartNominee.name %></td>
      <td><%= vote.styleNominee.name %></td>
      <td><%= vote.popularNominee.name %></td>
      <td>
        <%= vote.createdAt.toLocaleString('en-US', {
            hour: 'numeric',
            minute: '2-digit',
            hour12: true,
          }) %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<%- contentFor('title') %>
Dashboard
